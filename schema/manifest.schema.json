{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specula add-on manifest",
  "type": "object",
  "required": ["id", "name", "version", "types"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "types": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "idPrefixes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
    "catalogs": { "type": "array", "items": { "$ref": "#/$defs/catalog" } },
    "logo": { "type": "string", "pattern": "^https://" },
    "background": { "type": "string", "pattern": "^https://" },
    "contactEmail": { "type": "string", "minLength": 3 },
    "behaviorHints": { "$ref": "#/$defs/behaviorHints" },
    "specula": { "$ref": "#/$defs/specula" }
  },
  "$defs": {
    "resource": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "types": { "type": "array", "items": { "type": "string" } },
            "idPrefixes": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "catalog": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "extra": { "type": "array", "items": { "$ref": "#/$defs/catalogExtra" } },
        "extraRequired": { "type": "array", "items": { "type": "string" } },
        "extraSupported": { "type": "array", "items": { "type": "string" } }
      }
    },
    "catalogExtra": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "isRequired": { "type": "boolean" },
        "options": { "type": "array", "items": { "type": "string" } },
        "optionsLimit": { "type": "integer", "minimum": 1 }
      }
    },
    "behaviorHints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adult": { "const": false },
        "p2p": { "const": false },
        "configurable": { "type": "boolean" },
        "configurationRequired": { "type": "boolean" }
      }
    },
    "specula": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "options": { "$ref": "#/$defs/options" },
        "homeRows": { "type": "array", "items": { "$ref": "#/$defs/homeRow" } },
        "menuItems": { "type": "array", "items": { "$ref": "#/$defs/menuItem" } },
        "attribution": { "$ref": "#/$defs/attribution" }
      }
    },
    "options": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": { "type": "array", "items": { "$ref": "#/$defs/optionField" } }
      }
    },
    "optionField": {
      "type": "object",
      "required": ["key", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "footnote": { "type": "string" },
        "kind": { "$ref": "#/$defs/optionKind" },
        "defaultValue": { "type": "string" }
      }
    },
    "optionKind": {
      "oneOf": [
        {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "placeholder": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "required": ["secret"],
          "additionalProperties": false,
          "properties": {
            "secret": { "type": "object", "additionalProperties": false, "properties": {} }
          }
        },
        {
          "type": "object",
          "required": ["toggle"],
          "additionalProperties": false,
          "properties": {
            "toggle": { "type": "object", "additionalProperties": false, "properties": {} }
          }
        },
        {
          "type": "object",
          "required": ["choice"],
          "additionalProperties": false,
          "properties": {
            "choice": {
              "type": "object",
              "required": ["options"],
              "additionalProperties": false,
              "properties": {
                "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/choice" } }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["metadataProviders"],
          "additionalProperties": false,
          "properties": {
            "metadataProviders": {
              "type": "object",
              "required": ["row"],
              "additionalProperties": false,
              "properties": { "row": { "type": "string", "minLength": 1 } }
            }
          }
        }
      ]
    },
    "choice": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "homeRow": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "catalogID": { "type": "string", "minLength": 1 },
        "type": { "enum": ["movie", "series", "other"] },
        "query": { "$ref": "#/$defs/query" }
      }
    },
    "query": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["trending", "popular"] },
        "media": { "enum": ["movie", "series", "all"] },
        "window": { "enum": ["day", "week"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "media": { "type": "string", "minLength": 1 },
            "window": { "type": "string", "minLength": 1 },
            "providers": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "menuItem": {
      "type": "object",
      "required": ["id", "title", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "action": { "enum": ["fetchSubtitles", "listAlternativeStreams"] }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["id", "name", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" },
        "logo": { "type": "string" }
      }
    }
  }
}
